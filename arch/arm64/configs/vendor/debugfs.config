CONFIG_PAGE_OWNER=n
CONFIG_DEBUG_FS=n
# Hardware trace/debug infra, not needed for shipping. Also carries
# a real used-uninitialized bug (coresight-byte-cntr.c) not worth
# fixing in code we don't need.
CONFIG_CORESIGHT=n
# ThinLTO defers __crc_* symbol resolution to the LTO backend pass,
# which LLD can't emit as R_AARCH64_ABS32 relocations against --
# arm64 never selects MODULE_REL_CRCS (only powerpc/s390/um do), so
# there's no relative-CRC escape hatch here. MODVERSIONS (module ABI
# versioning across separately-built modules) isn't load-bearing for
# a single monolithic vmlinux build.
CONFIG_MODVERSIONS=n
# Pure runtime overhead, diagnostic-only. Don't gate crash capture --
# unlike SOFTLOCKUP_DETECTOR/DETECT_HUNG_TASK/PANIC_ON_OOPS (kept),
# which are what actually trigger a pstore dump on a hang.
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_SCHEDSTATS=n
CONFIG_IPC_LOGGING=n

# Ported from Nox-Staging-resequence (502468a7404f). Full lockdep --
# validates irq/preempt/lock nesting continuously and reports the
# exact site the moment an imbalance happens, unlike DEBUG_PREEMPT
# alone. Has real per-lock-acquire overhead -- temporary diagnostic
# aid, not meant to ship. Needed kernel/rcu/update.c's
# rcu_trace_lock_map definition ported too (same missing-symbol gap
# as Nox had).
CONFIG_PROVE_LOCKING=y
