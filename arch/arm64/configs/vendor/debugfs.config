CONFIG_PAGE_OWNER=n
CONFIG_DEBUG_FS=n

# TEMPORARY diagnostic aid: tracking down the intermittent
# "scheduling while atomic" crash-loop (0x00000201 preempt_count,
# hits a different random task each time, present since well before
# this bring-up's current DTS/driver work). CONFIG_DEBUG_PREEMPT is
# already on and gives "Preemption disabled at: <site>" -- but that
# field just records whatever preempt-disabling call happened MOST
# RECENTLY on an already-corrupted counter, so it drifts between
# captures (irq_enter, binder_inc_ref_for_node, empty) instead of
# pointing at the actual call site that broke the balance.
# CONFIG_PROVE_LOCKING pulls in full lockdep (LOCKDEP, TRACE_IRQFLAGS,
# DEBUG_SPINLOCK/MUTEXES/etc.) which validates irq/preempt/lock
# nesting continuously and reports the exact site the moment an
# imbalance happens. Has real runtime overhead -- remove once the
# actual culprit is found, not meant to ship.
CONFIG_PROVE_LOCKING=y
