CONFIG_PAGE_OWNER=n
CONFIG_DEBUG_FS=n

# CONFIG_PROVE_LOCKING (full lockdep) was a temporary diagnostic aid
# for the "scheduling while atomic" crash-loop -- root-caused and
# fixed (__migrate_hrtimers' unbalanced local_bh_disable(), see
# kernel/time/hrtimer.c). Lockdep has real per-lock-acquire runtime
# overhead; removed now that its job is done.
# CONFIG_PROVE_LOCKING is not set
