# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Master switch for every trace_android_vh_*/trace_android_rvh_* hook in
# the tree (WALT scheduler, binder, memory, BPF syscall checks, etc).
# Set in Google's gki_defconfig but not carried into lahaina-qgki_defconfig;
# without it, DECLARE_HOOK()'d functions like android_vh_ipi_stop_rcuidle
# and android_vh_printk_store never get declared and their callers
# (arch/arm64/kernel/smp.c, kernel/printk/printk.c) fail to build.
CONFIG_ANDROID_VENDOR_HOOKS=y

# Loadable module support -- has no `default`, so Kconfig leaves it off
# unless something explicitly enables it. Set in gki_defconfig but, like
# ANDROID_VENDOR_HOOKS above, not carried into lahaina-qgki_defconfig.
# Without it every =m symbol in the merged .config silently collapses to
# "not set" and nothing gets built as a vendor .ko (camera, display,
# audio codecs, WLAN, ...) -- vmlinux links fine, it's just missing all
# the modules Android actually loads at boot via vendor_boot/init.
CONFIG_MODULES=y


# Battery
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_QTI_BATTERY_GLINK_DEBUG=y

# PM8350B internal haptic actuator
CONFIG_INPUT_QCOM_HV_HAPTICS=y

# Glyph LEDs
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AW210XX=y

# Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
# CONFIG_SND_USB_AUDIO_QMI is not set

# Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_BRL=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y
# lahaina-qgki_defconfig turns this on for the wider Lahaina reference
# platform; Spacewar's real touch stack is Goodix + Novatek above.
# drivers/input/touchscreen/focaltech_touch/Makefile unconditionally
# descends into a focaltech_test/ subdirectory that doesn't exist in
# any tree this kernel was assembled from, so leaving FTS on breaks
# the build for hardware this phone doesn't have anyway.
# CONFIG_TOUCHSCREEN_FTS is not set


# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
