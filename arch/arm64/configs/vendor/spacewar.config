# Spacewar build config
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# TEMPORARY bring-up aid: lahaina-qgki_defconfig sets CONFIG_PANIC_ON_OOPS=y,
# so panic_on_oops boots defaulting to 1 (kernel/panic.c: panic_on_oops =
# CONFIG_PANIC_ON_OOPS_VALUE, which Kconfig derives to 1 whenever
# PANIC_ON_OOPS=y -- setting CONFIG_PANIC_ON_OOPS_VALUE directly would just
# get silently overridden by that same default rule). Disabling this lets a
# real Oops kill only the offending thread/process instead of panicking the
# whole device, so we can keep a live adb session and keep pulling logs past
# a crash point instead of losing the session to an instant reboot. Android's
# own init.rc separately re-writes panic_on_oops=1 during `on init`, which
# would undo this before our actual crash point (~boot animation handoff);
# device/nothing/Spacewar/init/init.target.rc's `on boot` block (which runs
# after every `on init` across all rc files) re-disables it there too.
# Revert both once the underlying crash is root-caused -- this is strictly a
# debugging aid, not something to ship.
# CONFIG_PANIC_ON_OOPS is not set

# Master switch for every trace_android_vh_*/trace_android_rvh_* hook in
# the tree (WALT scheduler, binder, memory, BPF syscall checks, etc).
# Set in Google's gki_defconfig but not carried into lahaina-qgki_defconfig;
# without it, DECLARE_HOOK()'d functions like android_vh_ipi_stop_rcuidle
# and android_vh_printk_store never get declared and their callers
# (arch/arm64/kernel/smp.c, kernel/printk/printk.c) fail to build.
CONFIG_ANDROID_VENDOR_HOOKS=y

# Loadable module support -- has no `default`, so Kconfig leaves it off
# unless something explicitly enables it. Set in gki_defconfig but, like
# ANDROID_VENDOR_HOOKS above, not carried into lahaina-qgki_defconfig.
# Without it every =m symbol in the merged .config silently collapses to
# "not set" and nothing gets built as a vendor .ko (camera, display,
# audio codecs, WLAN, ...) -- vmlinux links fine, it's just missing all
# the modules Android actually loads at boot via vendor_boot/init.
CONFIG_MODULES=y

# UFS inline hardware crypto (File-Based Encryption). CONFIG_BLK_INLINE_ENCRYPTION
# is already on (generic block-layer framework), but with none of these it has
# no actual hardware backend -- fscrypt/keystore's key type registration still
# succeeds, but vold has nothing to program per-file keys into. Confirmed via
# a real device: this is the exact cause of a factory-reset boot's
# "init_user0_failed" screen (vold can't set up user 0's encrypted CE storage).
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_CRYPTO_QTI=y
CONFIG_QTI_CRYPTO_COMMON=y
CONFIG_QTI_HW_KEY_MANAGER=y


# Battery
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_QTI_BATTERY_GLINK_DEBUG=y

# PM8350B internal haptic actuator
CONFIG_INPUT_QCOM_HV_HAPTICS=y

# Glyph LEDs
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AW210XX=y

# Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
# CONFIG_SND_USB_AUDIO_QMI is not set

# Touchscreen
# Matches AOSPA beryl's wiring: the real populated touch panel on
# retail units is Focaltech, not Goodix -- both nodes are declared in
# the shared yupik-qrd.dtsi reference, but neither AOSPA nor LineageOS
# ship goodix_berlin_driver at all, so goodix-berlin@0 just sits
# unbound on their builds. Disabling it here so it stops contesting
# SPI chipselect 0 against the real Focaltech panel.
#
# AOSPA does NOT use the generic focaltech_touch driver for this
# device -- they use focaltech_nothing, a fork imported directly from
# Nothing's own OS source (see aospa/beryl commit 5ab85f1c525a
# "input: Import Nothing Focaltech drivers" and follow-ups). Both
# drivers register the same "focaltech,fts_ts" compatible string, so
# they're mutually exclusive -- generic focaltech_touch's SPI
# read/reset sequencing doesn't match this specific chip firmware
# (probe failed with CRC-abnormal reads / boot-id 0x0000 on real
# hardware), switching to the Nothing-specific fork is what actually
# gets the panel responding.
CONFIG_INPUT_TOUCHSCREEN=y
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_TOUCHSCREEN_NOTHING=y


# NOTE on display: do NOT set CONFIG_DRM_MSM here. techpack/display/Makefile
# already sets it (and CONFIG_DISPLAY_BUILD=m) itself via an out-of-band
# `export` when it takes the lahainadisp.conf auto-detect branch -- but that
# export is scoped to techpack/display/Makefile's own recursive sub-make, so
# it only affects techpack/display/msm/'s own obj-$(CONFIG_DRM_MSM) += msm/
# line. Setting CONFIG_DRM_MSM=y as a real, global Kconfig symbol here (via
# this fragment -> .config -> auto.conf) ALSO enables the separate, unrelated
# obj-$(CONFIG_DRM_MSM) += msm/ line in drivers/gpu/drm/Makefile -- pulling
# in drivers/gpu/drm/msm/adreno/*, which duplicate-symbol-conflicts with the
# real Adreno GPU driver at drivers/gpu/msm/ (KGSL, CONFIG_QCOM_KGSL=y):
# ld.lld: duplicate symbol: a6xx_gmu_gx_is_on / adreno_idle / etc. Confirmed
# via drivers/gpu/drm/msm/Makefile diff: techpack/display/msm/ builds its
# own DRM/KMS/DSI driver and does NOT need the upstream drm/msm/adreno/
# stub at all; KGSL already covers Adreno on this SoC.

# WLAN
# CONFIG_CNSS2/CNSS2_QMI/ICNSS2* (the PCIe/QMI platform glue) were already
# on and initializing fine (confirmed via dmesg: "pcie:pcie_init." and
# cnss_utils coming up at boot), but nothing ever bound to the device
# afterward -- no interface, no further cnss/wlan/pcie log lines at all.
# Root cause: drivers/staging/qcacld-3.0 (the actual Qualcomm Atheros CLD
# WLAN chip driver) was present in-tree but its Kconfig was never sourced
# from drivers/staging/Kconfig, and drivers/staging/Makefile had no
# obj-$(CONFIG_QCA_CLD_WLAN) line either -- so the symbol didn't exist and
# could never be selected, regardless of any config fragment. Matches
# AOSPA's phone1_defconfig (=y, built-in, not a module).
CONFIG_QCA_CLD_WLAN=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
