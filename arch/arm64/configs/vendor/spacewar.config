#
# Core
#
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_ARCH_YUPIK=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

#
# Nothing platform (hardware-ID, secure/slot state, thermal, bootloader log)
#
CONFIG_NT_HWID=y
CONFIG_NT_SECURE_STATE=y
CONFIG_NT_SLOT_STATE=y
CONFIG_NT_THERMAL_INTERFACE=y
CONFIG_NOTHING_BOOTLOADER_LOG=y

#
# Security
#
# ARM64_PAN is a real ARMv8.1+ hardware protection already present on this
# silicon (not a software mitigation with a hardware alternative) -- kept
# enabled deliberately, diverging from Willay24's reference which disables
# it. The rest below match Willay24's reference; SLUB_DEBUG/VMAP_STACK are
# software-only debug/hardening features with no hardware equivalent on
# this chip, and HARDEN_BRANCH_PREDICTOR/UNMAP_KERNEL_AT_EL0 are software
# mitigations for CPU-class vulnerabilities whose hardware-mitigation
# status on this specific Kryo 670 revision is unverified -- not disabled
# on a confirmed "hardware covers it" basis, just matching the reference.
CONFIG_ARM64_PAN=y
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_VHE is not set
# CONFIG_CORESIGHT is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_INTEGRITY is not set
# CONFIG_RANDOMIZE_MODULE_REGION_FULL is not set
# CONFIG_SECURITY_SELINUX_AVC_STATS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_VMAP_STACK is not set

#
# Power
#
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_QTI_BATTERY_GLINK_DEBUG=y
CONFIG_INPUT_PM8941_PWRKEY=y

#
# Subsystem restart (modem/WiFi/ADSP crash recovery)
#
CONFIG_MSM_SUBSYSTEM_RESTART=y

#
# WiFi
#
CONFIG_CNSS_QCA6750=y
CONFIG_QCA_CLD_WLAN=y

#
# Haptics (PM8350B internal actuator)
#
CONFIG_INPUT_QCOM_HV_HAPTICS=y

#
# Glyph LEDs
#
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AW210XX=y

#
# Audio
#
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_AUDIO_QGKI=y
CONFIG_SND_USB_AUDIO_QMI=y

#
# Touchscreen
#
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_BRL=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_NOTHING_TOUCH=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y

#
# Fingerprint
#
CONFIG_GOODIX_FINGERPRINT=y
