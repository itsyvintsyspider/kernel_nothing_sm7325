# Board identity: SM7325 Yupik (Nothing Phone 1 / Spacewar).
# lahaina_QGKI.config is generic across the whole LAHAINA chipset
# ---------------------------------------------------------------------
CONFIG_ARCH_YUPIK=y
CONFIG_PINCTRL_YUPIK=y

# ---------------------------------------------------------------------
# Build-output settings the device's Android build (BoardConfig.mk)
# depends on.
# ---------------------------------------------------------------------
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y

# ---------------------------------------------------------------------
# Haven/Gunyah hypervisor IRQ-lending framework. Needed by trusted
# touch (focaltech/nt36xxx/st all #include hh_irq_lend.h) and
# display's sde_vm_trusted.c, not just VM-guest scenarios.
# ---------------------------------------------------------------------
CONFIG_VIRT_DRIVERS=y
CONFIG_HAVEN_DRIVERS=y
CONFIG_HH_CTRL=y
CONFIG_HH_MSGQ=y
CONFIG_HH_RM_DRV=y
CONFIG_HH_DBL=y
CONFIG_HH_IRQ_LEND=y
CONFIG_HH_MEM_NOTIFIER=y
CONFIG_HH_VIRT_WATCHDOG=y

# ---------------------------------------------------------------------
# lahaina_QGKI.config only sets these drivers' *sub-options*
# (ARM_SMMU_SKIP_MAP_POWER_ON, COMMON_CLK_QCOM_DEBUG, etc.) without
# ever setting the parent symbol itself -- no-ops without this.
# Needed by clk-qcom (clk_regmap_div_ops etc.), IOMMU (SMMU), SMEM,
# and QTEE shared-memory bridge (display/camera secure paths).
# ---------------------------------------------------------------------
CONFIG_QCOM_SCM=y
CONFIG_ARM_SMMU=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_SMEM=y

# --------------------------------------------------------
# Emulator hardware isn't needed on our device, begone :p
# --------------------------------------------------------
CONFIG_ANDROID_VSOC=n
CONFIG_RTC_DRV_PL030=n
CONFIG_RTC_DRV_PL031=n
CONFIG_USB_DUMMY_HCD=n
CONFIG_LIBNVDIMM=n

# ---------------------------------------------------
# No FM radio or HDMI/CEC hardware on this device
# ---------------------------------------------------
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_MEDIA_CEC_SUPPORT=n
# lt9611/lontium: no USB-C-to-HDMI bridge chip on this device
CONFIG_DRM_LONTIUM_LT9611UXC=n

# ------------------------------
# SoC platform / power / PMIC
# ------------------------------
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_PROXY_OF_CONSUMER=y
CONFIG_QCOM_QFPROM_SYS=y
CONFIG_QCOM_WDT_CORE=y
CONFIG_QCOM_EUD=y
CONFIG_QCOM_MICRODUMP=y
CONFIG_QCOM_MEMORY_DUMP_V2=y
CONFIG_QCOM_SYSMON_SUBSYSTEM_STATS=y
CONFIG_QCOM_SMCINVOKE=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_MSM_QMP=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_MFD_I2C_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QPNP_PBS=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=y
CONFIG_POWER_RESET_QCOM_REBOOT_REASON=y
CONFIG_QTI_PMIC_PON_LOG=y
CONFIG_QTI_IOMMU_SUPPORT=y
CONFIG_HW_RANDOM_MSM_LEGACY=y

# ---------------------------------------------------------------------
# Regulators (REGULATOR_QPNP_AMOLED/LCDB power the display panel)
# ---------------------------------------------------------------------
CONFIG_REGULATOR_PROXY_CONSUMER=y
CONFIG_REGULATOR_QPNP_AMOLED=y
CONFIG_REGULATOR_QPNP_LCDB=y
CONFIG_REGULATOR_QTI_FIXED_VOLTAGE=y
CONFIG_REGULATOR_REFGEN=y
CONFIG_REGULATOR_STUB=y

# ---------------------------------------------------------------------
# Display / GPU / camera / video clock controllers + GPU + backlight
# ---------------------------------------------------------------------
CONFIG_SM_DISPCC_YUPIK=y
CONFIG_SM_GPUCC_YUPIK=y
CONFIG_SM_CAMCC_YUPIK=y
CONFIG_SM_VIDEOCC_YUPIK=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y

# ---------------------------------------------------------------------
# Subsystem restart / remoteproc / IPC (modem, ADSP, CDSP, SLPI)
# ---------------------------------------------------------------------
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_MSM_SERVICE_LOCATOR=y
CONFIG_MSM_GLINK_SSR=y
CONFIG_SETUP_SSR_NOTIF_TIMEOUTS=y
CONFIG_MSM_CDSP_LOADER=y
CONFIG_MSM_CORE_HANG_DETECT=y
CONFIG_MSM_SPSS_UTILS=y
CONFIG_QRTR=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_SPSS=y
CONFIG_QSEECOM=y
CONFIG_QSEE_IPC_IRQ=y
CONFIG_QSEE_IPC_IRQ_BRIDGE=y
CONFIG_UIO_MSM_SHAREDMEM=y
CONFIG_SENSORS_SSC=y
CONFIG_HVC_HAVEN=y
CONFIG_MSM_QBT_HANDLER=y

# ---------------------------------------------------------------------
# Mobile data / WiFi / NFC / netfilter bits
# ---------------------------------------------------------------------
CONFIG_IPA3=y
CONFIG_ICNSS2=y
CONFIG_CNSS_GENL=y
CONFIG_MHI_BUS=y
CONFIG_PCI_MSM=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_XFRM_MIGRATE=y
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NFC_QTI_I2C=y

# ---------------------------------------------------------------------
# Storage / inline crypto (FBE) / crypto engine
# ---------------------------------------------------------------------
CONFIG_PHY_QCOM_UFS=y
CONFIG_SCSI_UFS_CRYPTO_QTI=y
CONFIG_QTI_HW_KEY_MANAGER=y
CONFIG_MMC_CQHCI_CRYPTO=y
CONFIG_CHR_DEV_SG=y
CONFIG_CRYPTO_DEV_QCEDEV=y
CONFIG_CRYPTO_DEV_QCOM_MSM_QCE=y
CONFIG_CRYPTO_XCBC=y
CONFIG_INCREMENTAL_FS=y

# ---------------------------------------------------------------------
# USB (DWC3 + PHYs + type-C + adb/diag/gsi gadget functions)
# ---------------------------------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_MSM_HSUSB_PHY=y
CONFIG_USB_MSM_SSPHY_QMP=y
CONFIG_USB_QCOM_EMU_PHY=y
CONFIG_USB_XHCI_HCD=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_TYPEC_UCSI=y
CONFIG_USB_BAM=y
CONFIG_USB_REDRIVER_NB7VPQ904M=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_USB_CONFIGFS_F_CCID=y
CONFIG_USB_CONFIGFS_F_CDEV=y
CONFIG_USB_CONFIGFS_F_DIAG=y
CONFIG_USB_CONFIGFS_F_GSI=y
CONFIG_USB_CONFIGFS_F_QDSS=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_SND_USB_AUDIO_QMI=y

# ------------------------------------------------------------------------
# Touch: Nothing's Focaltech fork (coutesy of AOSPA/beryl) goated source
# ------------------------------------------------------------------------
CONFIG_TOUCHSCREEN_NOTHING=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_TOUCHSCREEN_USB_COMPOSITE=y

# ---------------------------------------------------------------------
# Crash capture: pstore itself is already on, but nothing was turning
# on the detectors that trigger a dump when the device hangs instead
# of oopsing (a silent hang never flushes pstore).
# ---------------------------------------------------------------------
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_RCU_PANIC_ON_STALL=1

# ---------------------------------------------------------------------
# WireGuard (needs the chacha20poly1305 AEAD it selects)
# ---------------------------------------------------------------------
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_CHACHA20_NEON=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

# ---------------------------------------------------------------------
# General Android/perf bits both references carry
# ---------------------------------------------------------------------
CONFIG_HZ_300=y
CONFIG_RELAY=y
CONFIG_RCU_BOOST=y
CONFIG_BLK_WBT=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BPF_LSM=y
CONFIG_USERFAULTFD=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_STRIP_ASM_SYMS=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_FQ_CODEL=y
# USB-OTG storage/gamepad filesystems + drivers (kept, as with the rest
# of the USB accessory support)
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# ---------------------------------------------------------------------
# BPF. The core set already comes from gki_defconfig /
# lahaina_QGKI.config; these two round out the bpf-5.10 backport
# (Tashar02/upstream/bpf-5.10).
# ---------------------------------------------------------------------
CONFIG_BPF_STREAM_PARSER=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# ---------------------------------------------------------------------
# Clocks / RPMh / power domains / LLCC
# ---------------------------------------------------------------------
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_RPMH=y
CONFIG_QCOM_YUPIK_LLCC=y
CONFIG_MSM_CLK_AOP_QMP=y
CONFIG_INTERCONNECT_QCOM_YUPIK=y
CONFIG_INTERCONNECT_QCOM_EPSS_L3=y
CONFIG_REGULATOR_QCOM_PM8008=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_PWM_QTI_LPG=y
CONFIG_QCOM_SOC_WATCHDOG=y
CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y

# ---------------------------------------------------------------------
# GLINK / QRTR / SSR notifier
# ---------------------------------------------------------------------
CONFIG_QCOM_GLINK=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_QRTR_HAVEN=y
CONFIG_QCOM_SMP2P_SLEEPSTATE=y
CONFIG_MSM_SERVICE_NOTIFIER=y
CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT=y
CONFIG_MHI_UCI=y

# -----------------------------------------
# UFS + inline crypto
# -----------------------------------------
CONFIG_SCSI_UFS_QCOM=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_PHY_QCOM_UFS_QRBTC_SDM845=y
CONFIG_MMC_CQHCI_CRYPTO_QTI=y
CONFIG_QTI_CRYPTO_COMMON=y

# -----
# USB
# -----
CONFIG_USB_DWC3_MSM=y

# ------------------------------------------------------
# Wi-Fi related stuff (Extra configs from qcacld-3.0)
# ------------------------------------------------------
CONFIG_CNSS2=y
CONFIG_CNSS_QCA6750=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_ICNSS2_QMI=y
CONFIG_IPA_WDI_UNIFIED_API=y

# -------------------------------------------
# Haptics / LEDs / secure display / touch
# -------------------------------------------
CONFIG_INPUT_QCOM_HV_HAPTICS=y
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
CONFIG_LEDS_QTI_FLASH=y
CONFIG_LEDS_QTI_TRI_LED=y
CONFIG_HDCP_QSEECOM=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y

# -------------------------
# Nothing-specific stuff
# -------------------------
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_LEDS_AW210XX=y

# ---------------------------------------------------------------
# Third layer (visible only once CNSS2/GLINK/etc. were on): WiFi
# sub-options, ADSP/CDSP FastRPC, spcom, PMIC-GLINK.
# ---------------------------------------------------------------
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_ASYNC=y
CONFIG_BUS_AUTO_SUSPEND=y
CONFIG_MSM_ADSPRPC=y
CONFIG_MSM_SPCOM=y
CONFIG_QCOM_CDSP_RM=y
CONFIG_QCOM_GLINK_PKT=y
CONFIG_QTI_PMIC_GLINK=y
