# Device-specific and Nothing-specific config for the Nothing Phone (1) (Spacewar).
# SoC/platform enablement lives in lahaina-qgki_defconfig; this fragment only
# holds what is specific to this device, plus overrides that must apply after it.

# ---------------------------------------------------------------------
# Build-output settings the device's Android build (BoardConfig.mk)
# depends on.
# ---------------------------------------------------------------------
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y

# --------------------------------------------------------
# Emulator hardware isn't needed on our device, begone :p
# --------------------------------------------------------
CONFIG_ANDROID_VSOC=n
CONFIG_RTC_DRV_PL030=n
CONFIG_RTC_DRV_PL031=n
CONFIG_USB_DUMMY_HCD=n
CONFIG_LIBNVDIMM=n

# ---------------------------------------------------
# No FM radio or HDMI/CEC hardware on this device
# ---------------------------------------------------
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_MEDIA_CEC_SUPPORT=n
# lt9611/lontium: no USB-C-to-HDMI bridge chip on this device
CONFIG_DRM_LONTIUM_LT9611UXC=n

# ---------------------------------------------------------------------
# NFC
# ---------------------------------------------------------------------
CONFIG_NFC_QTI_I2C=y

# ------------------------------------------------------------------------
# Touch: Nothing's Focaltech fork (coutesy of AOSPA/beryl) goated source
# ------------------------------------------------------------------------
CONFIG_TOUCHSCREEN_NOTHING=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_TOUCHSCREEN_USB_COMPOSITE=y

# ------------------------------------------------------
# Wi-Fi related stuff (Extra configs from qcacld-3.0)
# ------------------------------------------------------
CONFIG_CNSS2=y
CONFIG_CNSS_QCA6750=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_WLAN_RESIDENT_DRIVER=y
CONFIG_ICNSS2_QMI=y
CONFIG_IPA_WDI_UNIFIED_API=y

# -------------------------------------------
# Haptics (Nothing RichTap rides on HV haptics) / LEDs / trusted touch
# -------------------------------------------
CONFIG_INPUT_QCOM_HV_HAPTICS=y
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
CONFIG_LEDS_QTI_FLASH=y
CONFIG_LEDS_QTI_TRI_LED=y
CONFIG_NOVATEK_TRUSTED_TOUCH=y

# ---------------------------------------------------------------
# WiFi sub-options (visible only once CNSS2 is on)
# ---------------------------------------------------------------
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_ASYNC=y
CONFIG_BUS_AUTO_SUSPEND=y

# -----------------------------------------
# Nothing-specific
# Nothing OS platform drivers and options (NothingOSS sm7325/v/mr
# lahaina_QGKI.config; NOTHING/NOTHING_SPACEWAR from Nox). Built in.
# -----------------------------------------
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_NT_HWID=y
CONFIG_NT_SECURE_STATE=y
CONFIG_NT_SLOT_STATE=y
CONFIG_NOTHING_BOOTLOADER_LOG=y
CONFIG_NOTHING_WRITRBACK_KMSG=y
CONFIG_NOTHING_RESTART_HANDLER=y
CONFIG_NOTHING_TASK_MEMINFO=y
CONFIG_NOTHING_SIMULATED_NTC=y
CONFIG_NOTHING_STABILITY_TEST=n
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_LEDS_AW210XX=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_EXFAT_FS=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_CRYPTO_XCBC=y
CONFIG_ST21NFC=n

# Nothing disables memory hotplug/offlining (overrides the QGKI defaults)
CONFIG_MEMORY_HOTPLUG=n
CONFIG_MEMORY_HOTREMOVE=n
CONFIG_QCOM_MEM_OFFLINE=n
CONFIG_OVERRIDE_MEMORY_LIMIT=n

# -----------------------------------------
# Nox parity: boot-path tolerance and Android 16 compat
# -----------------------------------------
# Nox leaves panic_on_oops off; Cosmo's default (gki_defconfig) turns an
# oops into a panic + forced watchdog bite, which resets silently.
CONFIG_PANIC_ON_OOPS=n
# Android 16 bpfloader/netd reject a 5.4 kernel. Report 5.10 to those
# root processes only (kernel/sys.c newuname).
CONFIG_FAKE_UNAME_5_10=y

# ----------------------
# NoMount Support
# ----------------------
CONFIG_NOMOUNT=y

# -----------
# KernelSU
# -----------
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
CONFIG_KSU_LSM_SECURITY_HOOKS=y
# CONFIG_KSU_FEATURE_SULOG is not set
# CONFIG_KSU_FEATURE_ADBROOT is not set
CONFIG_KSU_HOSTSREDIRECT=y
# CONFIG_KSU_ENABLE_FULL_UID_CHECKS is not set
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=y
# CONFIG_KSU_NOPRINTK is not set
# CONFIG_KSU_SHELL_HAS_SU_ALWAYS is not set
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_COMPILE_AS_C23=y
CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y
