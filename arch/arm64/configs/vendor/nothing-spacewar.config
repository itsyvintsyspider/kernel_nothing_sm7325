# Board selection and core platform enablement for the Nothing Phone (1)
# "Spacewar" (SM7325/Yupik). Layer this on top of
# gki_defconfig + lahaina_consolidate.config + lahaina_QGKI.config.
#
# gki_defconfig is SoC-agnostic and lahaina_consolidate.config/
# lahaina_QGKI.config don't select a specific board, so none of this is
# pulled in by Kconfig `select`/`depends` chains on its own.

# Board/platform selection
CONFIG_ARCH_LAHAINA=y
CONFIG_ARCH_YUPIK=y
CONFIG_NOTHING=y
CONFIG_NOTHING_SPACEWAR=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Core SoC infrastructure. Without these, nothing else on this platform
# can come up: SMEM is the AP<->modem/subsystem shared-memory transport,
# COMMON_CLK_QCOM is the whole Qualcomm clock-control subsystem, and
# ARM_SMMU is required for DMA on the display/camera/GPU paths.
CONFIG_QCOM_SMEM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_ARM_SMMU=y

# Haven hypervisor IRQ-lending framework, needed by the trusted
# display/camera path (techpack/display's msm_drm.ko calls into
# drivers/virt/haven/hh_irq_lend.c).
CONFIG_VIRT_DRIVERS=y
CONFIG_HAVEN_DRIVERS=y
CONFIG_HH_RM_DRV=y
CONFIG_HH_IRQ_LEND=y

# CAF reference-platform accessory HID drivers (a VR/AR headset dock and
# a gamepad dock) whose USB vendor/device ID macros were never carried
# into drivers/hid/hid-ids.h by any tree this kernel was assembled from.
# Neither accessory exists for this phone; disable rather than guess at
# hardware IDs.
# CONFIG_HID_QVR is not set
# CONFIG_HID_AKSYS_QRD is not set
