/dts-v1/;
/plugin/;

#include "yupik-qrd.dtsi"
#include "nothing-spacewar-sm7325.dtsi"

/ {
	model = "Nothing Phone (1)";
	compatible = "qcom,yupik-idp", "qcom,yupik", "qcom,qrd";

	/* Production Spacewar uses the Yupik QRD variant. The stock DTBO dump
	 * identifies it with MSM IDs 475/515 and board ID 0x1000B/0.
	 */
	qcom,msm-id = <475 0x10000>, <515 0x10000>;
	qcom,board-id = <0x1000B 0>;
};
