/dts-v1/;
/plugin/;

#include "yupik-idp.dtsi"
#include "nothing-spacewar-sm7325.dtsi"

/ {
	model = "Nothing Phone (1)";
	compatible = "qcom,yupik-idp", "qcom,yupik", "qcom,idp";

	/* Lineage uses the Yupik platform. The stock Yupik IDP entries support
	 * MSM IDs 475/515 and use board ID 34/0.
	 */
	qcom,msm-id = <475 0x10000>, <515 0x10000>;
	qcom,board-id = <34 0>;
};
