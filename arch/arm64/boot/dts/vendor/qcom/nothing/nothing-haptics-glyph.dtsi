/*
 * Nothing/Spacewar-specific haptics and Glyph LED overrides.
 *
 * Copies of the blocks already defined in yupik-qrd.dtsi -- yupik-qrd.dtsi
 * stays untouched. Devicetree overlay merge is last-include-wins per
 * property, so anything redeclared here (after yupik-qrd.dtsi in the
 * #include chain) overrides the base value. Properties left out of a
 * redeclared node still inherit from yupik-qrd.dtsi.
 */

&pmk8350_sdam_2 {
	cl_brake@7c {
		reg = <0x7c 0x1>;
		bits = <0 8>;
	};
};

&pm8350b_haptics {
	nvmem-cell-names = "hap_cl_brake";
	nvmem-cells = <&hap_cl_brake>;
	nvmem-names = "hap_cfg_sdam";
	nvmem = <&pmk8350_sdam_46>;
	qcom,pbs-client = <&pm8350b_pbs2>;

	/*
	 * qcom,vmax-mv restored to stock: the earlier -45% cut here (for the
	 * original "earthquake tremor" complaint, before predefined effects
	 * even worked) turned out to also cap RichTap's own gain ceiling --
	 * RICHTAP_SETTING_GAIN's ioctl handler scales as
	 * (arg * chip->config.vmax_mv) / 128, and config.vmax_mv comes
	 * straight from this property. Confirmed by diffing against
	 * LineageOS's kernel (los-ref remote, lineage-24.0): their
	 * yupik-qrd.dtsi never touches this, stays at stock 9150, and their
	 * RichTap effects are strong/correct on identical hardware -- ours
	 * were faint specifically because this ceiling was suppressed under
	 * it, independent of which vibrator HAL/userspace code is on top.
	 * Vrms_mv left at stock -- that's the LRA resonance-calibration
	 * reference, not a loudness knob; scaling it risks breaking auto-cal
	 * instead of changing feel.
	 */
	qcom,Vrms_mv = <1270>;
	qcom,vmax-mv = <9150>;
	qcom,lra-period-us = <5880>;
	status = "ok";

	/*
	 * "Watery"/mushy feel root cause: brake.mode already defaults to
	 * AUTO_BRAKE in the driver (qcom-hv-haptics.c) even unset, but
	 * brake.sine_gain defaults to the weakest setting, BRAKE_SINE_GAIN_X1,
	 * since nothing here ever set qcom,brake-sine-gain. Weak brake gain
	 * means the LRA keeps ringing after each pulse instead of stopping
	 * hard, which reads as mushy/watery. qcom,brake-mode is set explicitly
	 * below even though it matches the existing default, just to document
	 * intent. Values are enum brake_mode / sine_gain indices, not raw
	 * register bits: mode 3 = AUTO_BRAKE, gain 2 = BRAKE_SINE_GAIN_X4
	 * (valid range 0-3, X1..X8). Applies globally; every predefined effect
	 * inherits this via memcpy in haptics_parse_per_effect_dt() unless a
	 * qcom,wf-brake-* property overrides it per-effect.
	 */
	qcom,brake-mode = <3>; /* AUTO_BRAKE */
	qcom,brake-sine-gain = <2>; /* BRAKE_SINE_GAIN_X4, was implicit X1 */

	/*
	 * ROOT CAUSE of the "earthquake tremor" bug (was the parked
	 * investigation, now resolved): none of these effect_N nodes --
	 * not here, not in stock yupik-qrd.dtsi, not anywhere in this
	 * driver's devicetree lineage -- ever set qcom,effect-id.
	 * haptics_parse_effects_dt() (qcom-hv-haptics.c) counts nodes with
	 * that property BEFORE parsing any of them; count is 0, so it
	 * returns success immediately without allocating chip->effects at
	 * all. chip->effects_count stays 0 forever, so
	 * haptics_load_periodic_effect()'s very first check
	 * (effects_count == 0) fails with -EINVAL for every single
	 * canned/predefined effect (CLICK, TICK, HEAVY_CLICK, all of it) --
	 * the entire per-effect qcom,wf-vmax-mv table below has never
	 * actually been reachable. Something upstream falls back to the
	 * constant/DIRECT_PLAY path on that failure, which uses the
	 * top-level qcom,vmax-mv ceiling instead -- hence every haptic
	 * feeling like the same generic full-strength buzz. IDs below
	 * match the node-name comments and qcacld's own Effect enum
	 * ordering (CLICK=0 ... HEAVY_CLICK=5); 7 is FIFO-sample-only per
	 * the existing comment, not part of the enum sequence.
	 */
	/*
	 * "All effects feel the same"/"tapping water" (2nd bug, found after
	 * the effect-id fix above): pm8350b.dtsi's own effect_0 through
	 * effect_5 all share the exact same 8-tuple qcom,wf-pattern-data
	 * (a generic Qualcomm reference-template envelope), the same
	 * qcom,wf-vmax-mv, and the same period -- so at the hardware level
	 * CLICK/DOUBLE_CLICK/TICK/THUD/POP/HEAVY_CLICK were always
	 * physically identical vibrations, just wrapped under different
	 * effect IDs. Only effect_7 (FIFO, not part of the standard Effect
	 * enum) ever had a real distinct waveform. Each tuple below is
	 * (amplitude <=0x1ff, per-step period, f_lra_x2); period/amplitude
	 * meanings and macro names from dt-bindings/input/qcom,hv-haptics.h
	 * (already in scope via pm8350b.dtsi's own #include). Shorter
	 * per-step periods (DIV_2/DIV_4/DIV_8) read as tighter/snappier;
	 * longer ones (T_LRA/X_2) read as heavier/slower. qcom,wf-vmax-mv
	 * is 4500 (125% of stock's uniform 3600mV) on every effect here --
	 * comfortably under both MAX_VMAX_MV (11000) and the top-level
	 * ceiling above (9150). Distinctness comes from the pattern shapes,
	 * not from varying the ceiling per effect anymore.
	 */
	effect_0 {
		/* CLICK -- short, clean single snap. General-purpose (most
		 * UI touches route here); framework's UDFPS-success routing
		 * moved off this to POP (effect_4), see frameworks/base.
		 */
		qcom,effect-id = <0>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x060 S_PERIOD_T_LRA_DIV_2 0>,
					<0x140 S_PERIOD_T_LRA_DIV_2 0>,
					<0x0a0 S_PERIOD_T_LRA_DIV_2 0>,
					<0x020 S_PERIOD_T_LRA_DIV_2 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_1 {
		/* DOUBLE_CLICK ("ti-tick") -- two short pulses with a real
		 * silent gap between them, not one blob. This is what
		 * BIOMETRIC_REJECT (UDFPS auth failure) actually plays.
		 */
		qcom,effect-id = <1>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x140 S_PERIOD_T_LRA_DIV_4 0>,
					<0x020 S_PERIOD_T_LRA_DIV_4 0>,
					<0x000 S_PERIOD_T_LRA_DIV_2 0>,
					<0x140 S_PERIOD_T_LRA_DIV_4 0>,
					<0x020 S_PERIOD_T_LRA_DIV_4 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_2 {
		/* TICK -- lightest, briefest, barely-there tap. Same
		 * ceiling as the others now; lightness comes from the low
		 * amplitude codes and short duration in the pattern below.
		 */
		qcom,effect-id = <2>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x0a0 S_PERIOD_T_LRA_DIV_4 0>,
					<0x030 S_PERIOD_T_LRA_DIV_4 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_3 {
		/* THUD -- deeper, heavier, slower. Long per-step periods
		 * (T_LRA/X_2) instead of short ones is what reads as
		 * "weight" rather than just "loud".
		 */
		qcom,effect-id = <3>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x0c0 S_PERIOD_T_LRA 0>,
					<0x1a0 S_PERIOD_T_LRA 0>,
					<0x160 S_PERIOD_T_LRA_X_2 0>,
					<0x080 S_PERIOD_T_LRA_X_2 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_4 {
		/* POP -- sharp, punchy, brief spike-then-decay. Now also
		 * what BIOMETRIC_CONFIRM (UDFPS auth success) plays,
		 * routed here in frameworks/base's HapticFeedbackVibration-
		 * Provider instead of falling through to generic CLICK.
		 */
		qcom,effect-id = <4>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x1a0 S_PERIOD_T_LRA_DIV_8 0>,
					<0x1ff S_PERIOD_T_LRA_DIV_4 0>,
					<0x080 S_PERIOD_T_LRA_DIV_4 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_5 {
		/* HEAVY CLICK -- strongest single click: higher peak and
		 * one more step of sustain than CLICK, same ceiling as the
		 * others but the fullest use of it.
		 */
		qcom,effect-id = <5>;
		qcom,wf-vmax-mv = <4500>;
		qcom,wf-pattern-data = <0x0e0 S_PERIOD_T_LRA_DIV_2 0>,
					<0x1c0 S_PERIOD_T_LRA_DIV_2 0>,
					<0x1e0 S_PERIOD_T_LRA_DIV_2 0>,
					<0x0e0 S_PERIOD_T_LRA_DIV_2 0>,
					<0x020 S_PERIOD_T_LRA_DIV_2 0>;
		qcom,wf-pattern-period-us = <5880>;
	};

	effect_7 {
		/* FIFO sample only, not one of the six canned Effect-enum
		 * IDs -- stock default here is 10000, not 3600 like the
		 * others, and 125% of that (12500) would exceed
		 * MAX_VMAX_MV (11000). Restored to stock as-is instead.
		 */
		qcom,effect-id = <7>;
		qcom,wf-vmax-mv = <10000>;
		qcom,wf-pattern-period-us = <5880>;
	};
};

&swr_haptics {
	status = "okay";
	swr-slave-supply = <&hap_swr_slave_reg>;
};

&tlmm {
	aw210xx_led_pins {
		led_gpio_en {
			mux {
				pins = "gpio18";
				function = "gpio";
			};

			config {
				pins = "gpio18";
				drive-strength = <2>;
				output-high;
				bias-pull-up;
			};
		};
	};
};

&qupv3_se1_i2c {
	status = "ok";
	aw210xx_led@20 {
		compatible = "awinic,aw210xx_led";
		reg = <0x20>;
		enable-gpio = <&tlmm 18 0x00>;
		global_current = <0x20>;
		osc_clk = <1>;
		br_res = <3>;
		pinctrl-names = "default";
		pinctrl-0 = <&led_gpio_en>;
		status = "ok";
		aw210xx,led {
			aw210xx,name = "aw210xx_led";
			aw210xx,imax = <1>;
			aw210xx,brightness = <4095>;
			aw210xx,max_brightness = <4095>;
		};
	};
};
