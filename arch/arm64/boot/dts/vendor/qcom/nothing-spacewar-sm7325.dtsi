// nothing-spacewar-sm7325.dtsi
// This file is for Nothing Phone (1) "spacewar" (SM7325 "Yupik") only.
// Camera, NFC, flash, and PMIC haptics are provided by the stock Yupik QRD
// include above. Spacewar uses Goodix Berlin on SPI instead of QRD's default
// FocalTech SPI node.

#include "yupik-abra-common-overlay.dtsi"
#include "nothing-spacewar-pinctrl.dtsi"
#include "nothing-spacewar-audio-overlay.dtsi"

&pm8350b_haptics {
	status = "ok";
};

&qupv3_se13_spi {
	status = "ok";
	qcom,rt;
	#address-cells = <1>;
	#size-cells = <0>;
	/delete-node/ focaltech@0;
};
