// nothing-spacewar-sm7325.dtsi
// This file is for Nothing Phone (1) "spacewar" (SM7325 "Yupik") only.


#include "yupik-abra-common-overlay.dtsi"
#include "nothing-spacewar-pinctrl.dtsi"
#include "nothing-spacewar-audio-overlay.dtsi"

/* device-specific states here. */
&pm8350c_flash {
	status = "ok";
};

&pm8350b_haptics {
	status = "ok";
	qcom,Vrms_mv = <1270>;
	qcom,vmax-mv = <9150>;
	qcom,lra-period-us = <5880>;
};

&qupv3_se1_i2c {
	status = "ok";
};

&qupv3_se9_i2c {
	status = "ok";
};

&st21nfc {
	status = "disabled";
};

&qupv3_se14_spi {
	status = "ok";
};

&icnss2 {
	use-nv-mac;
};

&sdhc_2 {
	status = "disabled";
};

/* Retail Spacewar panel profile from the Yupik QRD DTB. Panel definitions
 * and power tables remain in the shared Yupik display sources. */
&sde_dsi {
	vddio-supply = <&L12C>;
	vdd-supply = <&L13C>;
	/delete-property/ lab-supply;
	/delete-property/ ibb-supply;
	qcom,dsi-default-panel = <&dsi_rm692e5_visionox_amoled_120hz_cmd>;
	qcom,dsi-dummy-panel = <&dsi_r66451_amoled_144hz_video_cphy>;
};

&qupv3_se13_spi {
	status = "ok";
	qcom,rt;
	#address-cells = <1>;
	#size-cells = <0>;
	/delete-node/ focaltech@0;

	/*
	 * /delete-node/ above does not reliably propagate through this
	 * board's overlay build (CONFIG_BUILD_ARM64_DT_OVERLAY=y --
	 * out/.../dtbo.img packs 5000+ CAF reference-board fragments, and
	 * node deletion across that fragment-merge pipeline isn't as
	 * reliable as a plain property override). Confirmed on a real
	 * device: focaltech@0 was still live alongside goodix-berlin@0 in
	 * the booted devicetree (/proc/device-tree/soc/spi@a94000/ showed
	 * both), so the SPI core registered focaltech@0 first and rejected
	 * goodix-berlin@0 with "chipselect 0 already in use" -- the real
	 * touchscreen never got a chance to probe. Explicitly disabling it
	 * here is a plain property merge, which is reliable regardless of
	 * which fragment the overlay tooling actually selects.
	 */
	focaltech@0 {
		status = "disabled";
	};

	goodix-berlin@0 {
		compatible = "goodix,gt9916S", "goodix,brl-d";
		reg = <0>;
		spi-max-frequency = <1000000>;

		goodix,avdd-name = "avdd";
		avdd-supply = <&L3C>;
		goodix,iovdd-name = "iovdd";
		iovdd-supply = <&L8C>;

		goodix,reset-gpio = <&tlmm 105 0x00>;
		goodix,irq-gpio = <&tlmm 81 0x2800>;
		goodix,irq-flags = <2>;
		goodix,panel-max-x = <1080>;
		goodix,panel-max-y = <2400>;
		goodix,panel-max-w = <255>;
		goodix,panel-max-p = <4096>;
		goodix,pen-enable;
		goodix,firmware-name = "goodix_firmware.bin";
		goodix,config-name = "goodix_cfg_group.bin";
	};
};

&soc {
	nt-thermal-interface {
		compatible = "nothing,nt-thermal-interface";
		board-sensor = "spacewar-board-sensor";
		qcom,display-panels = <&dsi_rm692e5_visionox_amoled_120hz_cmd
					&dsi_r66451_amoled_144hz_video_cphy>;
	};
};